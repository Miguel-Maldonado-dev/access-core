# Configuración del panel de control de acceso.
# En la placa vive en /etc/acceso/acceso.env (modo 600, dueño acceso).

# Puerto serie conectado al ATmega (obligatorio para el daemon).
# Raspberry Pi: /dev/serial0   Orange Pi PC: /dev/ttyS3
UART_PORT=/dev/serial0
UART_BAUD=115200

# Acceso a la web (obligatorios).
ADMIN_USER=admin
ADMIN_PASSWORD=
SESSION_SECRET=

WEB_HOST=0.0.0.0
WEB_PORT=8080

DB_PATH=/var/lib/acceso/access_control.sqlite
LOG_MAX_ENTRIES=100000
SESSION_HOURS=12

# Socket local del daemon (pruebas de salida desde la web y el agente).
# Solo cambia en desarrollo (Mac); en la placa déjalo así.
DAEMON_SOCKET=/run/acceso/daemon.sock

# Solo para desarrollo (interfaz en otro puerto); en la placa déjala vacía.
CORS_ORIGINS=

# Interfaz compilada. El paquete se instala sin -e, por eso se indica la ruta.
STATIC_DIR=/opt/acceso/backend/acceso/web/static

# Agente de nube (acceso-cloud). Estas variables NO van aquí: viven en /etc/acceso/cloud.env
# (modo 600, dueño acceso), que crea install.sh si no existe y donde el agente guarda su
# credencial. Ejemplo de ese archivo:
#   CLOUD_URL=https://nube.ejemplo.com
#   MQTT_URL=mqtts://mqtt.ejemplo.com:8883
# Sin CLOUD_URL el agente queda inactivo y lo indica en su estado.
