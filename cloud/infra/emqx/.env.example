# Copia a .env (ignorado por git) en infra/emqx/. Sin secretos reales en el repositorio.
APP_URL=https://app.ejemplo.com
# Mismo valor que EMQX_WEBHOOK_SECRET de la aplicación.
EMQX_WEBHOOK_SECRET=cambia-este-secreto
EMQX_NODE_COOKIE=cambia-esta-cookie
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=cambia-esta-contrasena
# Carpeta con fullchain.pem y privkey.pem (certbot: /etc/letsencrypt/live/<dominio>).
EMQX_CERT_DIR=./certs
# Opcionales (puertos del anfitrión). Si Caddy usa el 443, define EMQX_WSS_PORT=8084.
# EMQX_MQTT_PORT=8883
# EMQX_WSS_PORT=443
# EMQX_API_PORT=18083   # siempre ligado a 127.0.0.1
# EMQX_CONTAINER_NAME=acceso-emqx
