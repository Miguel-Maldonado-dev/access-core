[Unit]
Description=Acceso - panel web del control de acceso
After=network.target

[Service]
Type=simple
User=acceso
UMask=0077
SupplementaryGroups=dialout
EnvironmentFile=/etc/acceso/acceso.env
WorkingDirectory=/var/lib/acceso
ExecStart=/opt/acceso/venv/bin/python -m acceso.web
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
