# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local.
# Las pruebas NO leen este archivo: usan el Supabase local (supabase status).

# Supabase (proyecto remoto de desarrollo en .env.local; el local lo da `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Nunca con el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Cifrado y búsqueda de PIN (claves de 32 bytes en base64)
PIN_ENC_KEY=
PIN_LOOKUP_KEY=

# EMQX (broker MQTT)
EMQX_API_URL=
EMQX_API_KEY=
EMQX_API_SECRET=
EMQX_WEBHOOK_SECRET=

# Secreto de los avisos internos (base de datos -> aplicación)
INTERNAL_WEBHOOK_SECRET=

# URL pública de la aplicación (el correo de invitación lleva a ${APP_URL}/auth/confirm;
# esa URL debe estar en las Redirect URLs de Supabase, ver README)
APP_URL=http://localhost:3000
