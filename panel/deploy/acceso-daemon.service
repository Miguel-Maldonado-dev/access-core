[Unit]
Description=Acceso - daemon UART del control de acceso
After=network.target

[Service]
Type=simple
User=acceso
UMask=0077
RuntimeDirectory=acceso
RuntimeDirectoryMode=0750
SupplementaryGroups=dialout
EnvironmentFile=/etc/acceso/acceso.env
WorkingDirectory=/var/lib/acceso
ExecStart=/opt/acceso/venv/bin/python -m acceso.daemon
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
